# OmniVoice local state and dev artifacts. The image only needs the
# Python source; voice profiles and generated audio are produced at runtime
# and persisted via the named volumes declared in docker-compose.yml.

# Generated artifacts — recreated per-container, kept off the image.
output/
voice_profiles/*.pt
voice_profiles/*.mp3
voice_profiles/*.wav
voice_inputs/

# Local Python venv and caches; requirements.txt covers deps.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Editor / OS noise.
.vscode/
.idea/
.DS_Store
