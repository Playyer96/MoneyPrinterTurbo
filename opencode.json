{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-ollama/llama3.2:3b",
  "provider": {
    "local-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local Bridge",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "temperature": 0.1,
        "topP": 0.1
      },
      "models": {
        "llama3.2:3b": {
          "name": "Llama 3.2 3B (local)"
        },
        "LisyNeko/qwen3.8-4b-coder:latest": {
          "name": "Qwen3.8 4B Coder (local)"
        },
        "gemma4:e4b": {
          "name": "Gemma 4 4B (local)"
        },
        "qwen3-vl:4b-instruct": {
          "name": "Qwen3 VL 4B Instruct (local)"
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B (local)"
        }
      }
    }
  },
  "tools": {
    "bash": true,
    "write": true,
    "edit": true,
    "read": true,
    "sandbox": true
  }
}