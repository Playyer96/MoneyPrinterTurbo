# Auto detect text files and normalize line endings in the repository
* text=auto

# Binary assets
*.mp3 binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.ttc binary
*.otf binary
*.woff binary
*.woff2 binary

# Files that a Linux shell parses must keep LF even when checked out on
# Windows. `text=auto` above would hand them CRLF, and every `\` line
# continuation in a RUN block then ends in a stray \r -- the build dies with
# "$'\r': command not found" instead of anything that names the real cause.
Dockerfile* text eol=lf
*.sh text eol=lf
Makefile text eol=lf
