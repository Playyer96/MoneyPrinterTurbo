#!/bin/sh
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
STATE_DIR="$REPO/.mpt-host"
BIN_DIR="$STATE_DIR/bin"
VENV_DIR="$STATE_DIR/venv"
LOG_DIR="$REPO/storage/logs"
VOICE_LABEL="com.moneyprinterturbo.voicestudio"
FFMPEG_LABEL="com.moneyprinterturbo.ffmpeg-proxy"
VOICE_PLIST="$STATE_DIR/$VOICE_LABEL.plist"
FFMPEG_PLIST="$STATE_DIR/$FFMPEG_LABEL.plist"
REQUIREMENTS="$REPO/vendor/voice_studio/requirements.txt"
REQUIREMENTS_STAMP="$STATE_DIR/requirements.cksum"
RUNTIME_STAMP="$STATE_DIR/runtime.cksum"

info() {
    printf '{"type":"info","message":"%s"}\n' "$1"
}

fail() {
    printf '{"type":"error","message":"%s"}\n' "$1"
    exit 1
}

xml_escape() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

find_action() {
    for argument in "$@"; do
        case "$argument" in
            up|down|stop)
                printf '%s\n' "$argument"
                return
                ;;
        esac
    done
}

stop_services() {
    domain="gui/$(id -u)"
    launchctl bootout "$domain/$VOICE_LABEL" >/dev/null 2>&1 || true
    launchctl bootout "$domain/$FFMPEG_LABEL" >/dev/null 2>&1 || true
}

bootstrap_uv() {
    if command -v uv >/dev/null 2>&1; then
        command -v uv
        return
    fi
    if [ -x "$BIN_DIR/uv" ]; then
        printf '%s\n' "$BIN_DIR/uv"
        return
    fi

    printf '%s\n' "Downloading the cached host Python bootstrap tool" >&2
    uv_container=""
    cleanup_uv_container() {
        if [ -n "$uv_container" ]; then
            docker rm -f "$uv_container" >/dev/null 2>&1 || true
        fi
    }
    trap cleanup_uv_container EXIT HUP INT TERM
    uv_container=$(docker create ghcr.io/astral-sh/uv:0.8.15 2>/dev/null) || \
        fail "Docker could not download the host Python bootstrap tool"
    docker cp "$uv_container:/uv" "$BIN_DIR/uv" >/dev/null 2>&1 || \
        fail "Docker could not extract the host Python bootstrap tool"
    chmod 755 "$BIN_DIR/uv"
    cleanup_uv_container
    trap - EXIT HUP INT TERM
    printf '%s\n' "$BIN_DIR/uv"
}

prepare_runtime() {
    mkdir -p "$BIN_DIR" "$LOG_DIR" "$STATE_DIR/models" "$STATE_DIR/voice_profiles"
    legacy_profiles="$REPO/vendor/voice_studio/voice_profiles"
    if [ -d "$legacy_profiles" ]; then
        cp -n "$legacy_profiles"/* "$STATE_DIR/voice_profiles/" 2>/dev/null || true
    fi
    uv_bin=$(bootstrap_uv)
    python_bin="$VENV_DIR/bin/python"
    current_stamp=$(cksum "$REQUIREMENTS")
    installed_stamp=""
    if [ -f "$REQUIREMENTS_STAMP" ]; then
        installed_stamp=$(sed -n '1p' "$REQUIREMENTS_STAMP")
    fi

    if [ ! -x "$python_bin" ] || [ "$current_stamp" != "$installed_stamp" ]; then
        info "Preparing the cached Apple Silicon acceleration runtime"
        UV_PYTHON_PREFERENCE=managed "$uv_bin" venv --python 3.11 "$VENV_DIR" >&2
        "$uv_bin" pip install --python "$python_bin" -r "$REQUIREMENTS" >&2
        printf '%s\n' "$current_stamp" > "$REQUIREMENTS_STAMP"
    fi

    "$python_bin" -c \
        'import torch; assert torch.backends.mps.is_available(), "PyTorch MPS is unavailable"' >&2 || \
        fail "Apple Metal acceleration is unavailable; CPU fallback is disabled"
    "$python_bin" -c 'import mlx_whisper' >&2 || \
        fail "MLX Whisper is unavailable; CPU fallback is disabled"
    ffmpeg_bin=$("$python_bin" -c 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())')
    "$ffmpeg_bin" -hide_banner -encoders 2>&1 | grep -q 'h264_videotoolbox' || \
        fail "The bundled macOS FFmpeg does not expose h264_videotoolbox"
    ln -sf "$ffmpeg_bin" "$BIN_DIR/ffmpeg"
}

write_plists() {
    repo_xml=$(xml_escape "$REPO")
    state_xml=$(xml_escape "$STATE_DIR")
    python_xml=$(xml_escape "$python_bin")
    ffmpeg_xml=$(xml_escape "$ffmpeg_bin")
    bin_xml=$(xml_escape "$BIN_DIR")

    printf '%s\n' \
        '<?xml version="1.0" encoding="UTF-8"?>' \
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
        '<plist version="1.0"><dict>' \
        "<key>Label</key><string>$VOICE_LABEL</string>" \
        '<key>ProgramArguments</key><array>' \
        "<string>$python_xml</string>" \
        "<string>$repo_xml/vendor/voice_studio/server.py</string>" \
        '</array>' \
        '<key>EnvironmentVariables</key><dict>' \
        '<key>VOICESTUDIO_HOST</key><string>0.0.0.0</string>' \
        '<key>VOICESTUDIO_PORT</key><string>8780</string>' \
        "<key>VOICESTUDIO_PROFILES_DIR</key><string>$state_xml/voice_profiles</string>" \
        "<key>HF_HOME</key><string>$state_xml/models</string>" \
        "<key>PATH</key><string>$bin_xml:/usr/bin:/bin:/usr/sbin:/sbin</string>" \
        '</dict>' \
        "<key>WorkingDirectory</key><string>$repo_xml</string>" \
        '<key>RunAtLoad</key><true/>' \
        '<key>KeepAlive</key><true/>' \
        '<key>ProcessType</key><string>Interactive</string>' \
        "<key>StandardOutPath</key><string>$repo_xml/storage/logs/voicestudio.log</string>" \
        "<key>StandardErrorPath</key><string>$repo_xml/storage/logs/voicestudio.log</string>" \
        '</dict></plist>' > "$VOICE_PLIST"

    printf '%s\n' \
        '<?xml version="1.0" encoding="UTF-8"?>' \
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
        '<plist version="1.0"><dict>' \
        "<key>Label</key><string>$FFMPEG_LABEL</string>" \
        '<key>ProgramArguments</key><array>' \
        "<string>$python_xml</string>" \
        "<string>$repo_xml/scripts/ffmpeg_mac_proxy.py</string>" \
        '</array>' \
        '<key>EnvironmentVariables</key><dict>' \
        '<key>MPT_FFMPEG_PROXY_HOST</key><string>127.0.0.1</string>' \
        '<key>MPT_FFMPEG_PROXY_PORT</key><string>8781</string>' \
        "<key>MPT_FFMPEG_BIN</key><string>$ffmpeg_xml</string>" \
        '</dict>' \
        "<key>WorkingDirectory</key><string>$repo_xml</string>" \
        '<key>RunAtLoad</key><true/>' \
        '<key>KeepAlive</key><true/>' \
        '<key>ProcessType</key><string>Interactive</string>' \
        "<key>StandardOutPath</key><string>$repo_xml/storage/logs/ffmpeg-mac-proxy.log</string>" \
        "<key>StandardErrorPath</key><string>$repo_xml/storage/logs/ffmpeg-mac-proxy.log</string>" \
        '</dict></plist>' > "$FFMPEG_PLIST"
}

wait_for_health() {
    url=$1
    name=$2
    attempts=$3
    count=0
    while [ "$count" -lt "$attempts" ]; do
        if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
            return
        fi
        count=$((count + 1))
        sleep 1
    done
    fail "$name did not become healthy; inspect storage/logs for details"
}

start_services() {
    [ "$(uname -s)" = "Darwin" ] || fail "The macOS accelerator provider can only run on macOS"
    [ "$(uname -m)" = "arm64" ] || fail "The macOS accelerator provider requires Apple Silicon"
    mkdir -p "$STATE_DIR"
    current_runtime=$(cksum \
        "$0" \
        "$REQUIREMENTS" \
        "$REPO/vendor/voice_studio/server.py" \
        "$REPO/scripts/ffmpeg_mac_proxy.py" | cksum)
    installed_runtime=""
    if [ -f "$RUNTIME_STAMP" ]; then
        installed_runtime=$(sed -n '1p' "$RUNTIME_STAMP")
    fi
    domain="gui/$(id -u)"
    if [ "$current_runtime" = "$installed_runtime" ] \
        && launchctl print "$domain/$VOICE_LABEL" >/dev/null 2>&1 \
        && launchctl print "$domain/$FFMPEG_LABEL" >/dev/null 2>&1 \
        && curl -fsS --max-time 2 http://127.0.0.1:8780/health >/dev/null 2>&1 \
        && curl -fsS --max-time 2 http://127.0.0.1:8781/health >/dev/null 2>&1; then
        info "Apple Metal, MLX, and VideoToolbox services are already ready"
        return
    fi

    prepare_runtime
    write_plists
    stop_services
    sleep 1
    launchctl bootstrap "$domain" "$VOICE_PLIST" >&2
    launchctl bootstrap "$domain" "$FFMPEG_PLIST" >&2
    wait_for_health "http://127.0.0.1:8780/health" "VoiceStudio" 60
    wait_for_health "http://127.0.0.1:8781/health" "FFmpeg VideoToolbox proxy" 20
    info "Warming the OmniVoice model on Apple Metal"
    curl -fsS -X POST http://127.0.0.1:8780/warmup >/dev/null || \
        fail "OmniVoice could not warm on Apple Metal; inspect storage/logs for details"
    printf '%s\n' "$current_runtime" > "$RUNTIME_STAMP"
    info "Apple Metal, MLX, and VideoToolbox services are ready"
}

action=$(find_action "$@")
case "$action" in
    up)
        start_services
        ;;
    down|stop)
        stop_services
        info "Apple host acceleration services stopped"
        ;;
    *)
        fail "Unsupported Compose provider command"
        ;;
esac
